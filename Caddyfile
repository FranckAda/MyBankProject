# {$DOMAIN} is injected by docker-compose.prod.yml from .env.prod
{$DOMAIN} {
    encode zstd gzip

    reverse_proxy frontend:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}
