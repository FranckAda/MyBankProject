# Copy to .env.prod on the server and fill every value. NEVER commit .env.prod.
# Used with: docker compose --env-file .env.prod -f docker-compose.prod.yml ...

DOMAIN=ton-domaine.fr

# Generate with: openssl rand -hex 32
APP_SECRET=replace_with_a_random_hex_string

DATABASE_URL=mysql://mybank:CHANGE_ME@db:3306/mybank?serverVersion=8.0&charset=utf8mb4
MYSQL_DATABASE=mybank
MYSQL_USER=mybank
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO

# Generate with: openssl rand -hex 24
JWT_PASSPHRASE=CHANGE_ME

# Same origin: the frontend proxies /api to the backend.
CORS_ALLOW_ORIGIN='^https://ton-domaine\.fr$'
DEFAULT_URI=https://ton-domaine.fr
MAILER_DSN=null://null
