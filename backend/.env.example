# Copier ce fichier en .env : cp backend/.env.example backend/.env
# Valeurs de DEVELOPPEMENT uniquement. Ne pas utiliser telles quelles en production.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=dev_only_change_me

# Dans docker-compose.yml, cette variable est remplacee par :
#   mysql://mybank:secret@db:3306/mybank?serverVersion=8.0&charset=utf8mb4
# Hors Docker (Symfony en local), gardez 127.0.0.1 et le mot de passe de votre MySQL local.
DATABASE_URL="mysql://root:rootsecret@127.0.0.1:3306/mybank?serverVersion=8.0&charset=utf8mb4"

# Regex : accepte http://localhost:3000, http://127.0.0.1:5173, etc.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
DEFAULT_URI=http://localhost:3000

MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
VAR_DUMPER_SERVER=127.0.0.1:9899

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=bankapp_jwt_passphrase
JWT_TTL=3600
